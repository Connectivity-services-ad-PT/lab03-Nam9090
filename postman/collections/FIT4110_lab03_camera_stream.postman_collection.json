            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has status property\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"status\");",
